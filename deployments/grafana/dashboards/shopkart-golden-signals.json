  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "ShopKart Golden Signals (Traffic, Latency, Errors)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "HTTP Request Rate (RPS by Service)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[30s])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "Latency p95 (Seconds by Service)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[30s])) by (le, service))",
          "legendFormat": "{{service}} p95"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "title": "5xx Server Error Rate (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[30s])) by (service, status)",
          "legendFormat": "{{service}} - HTTP {{status}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 101,
      "title": "Saturation & Bounded Resource Health",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "none" }
      },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 9 },
      "id": 4,
      "title": "Active In-Flight HTTP Requests",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(http_requests_in_flight) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1.0, "min": 0.0 }
      },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 9 },
      "id": 5,
      "title": "Worker Pool Utilization Ratio",
      "type": "timeseries",
      "targets": [
        {
          "expr": "worker_pool_utilization_ratio",
          "legendFormat": "{{service}} ({{pool_name}})"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "none" }
      },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 9 },
      "id": 6,
      "title": "Postgres Pool: Connections In Use & Waits",
      "type": "timeseries",
      "targets": [
        {
          "expr": "db_pool_connections_in_use",
          "legendFormat": "{{service}} in-use"
        },
        {
          "expr": "rate(db_pool_connections_wait_count[30s])",
          "legendFormat": "{{service}} wait-rate"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "none" }
      },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 9 },
      "id": 7,
      "title": "Kafka Consumer Lag & Queue Depth",
      "type": "timeseries",
      "targets": [
        {
          "expr": "consumer_lag",
          "legendFormat": "Consumer Lag ({{topic}})"
        },
        {
          "expr": "queue_depth",
          "legendFormat": "Queue Depth ({{queue}})"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 16 },
      "id": 8,
      "title": "Catalog Redis Cache Hit vs Miss Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(cache_hits_total[30s]))",
          "legendFormat": "Cache Hits/sec"
        },
        {
          "expr": "sum(rate(cache_misses_total[30s]))",
          "legendFormat": "Cache Misses/sec"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 16 },
      "id": 9,
      "title": "Process Resident Memory (RSS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ],
