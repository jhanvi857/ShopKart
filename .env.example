# ShopKart Operational Environment Variables
# Copy to .env before starting: cp .env.example .env

ENVIRONMENT=production
ADMIN_API_KEY=
POSTGRES_USER=shopkart_user
POSTGRES_PASSWORD=shopkart_pass_secret
POSTGRES_DB=shopkart_db
POSTGRES_PORT=5433
REDIS_PORT=6380
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
JAEGER_PORT=16686
STOREFRONT_PORT=3000
GATEWAY_PORT=9000
SHOPKART_FAULT_ENDPOINTS=true

# Lean Mode Toggles (graceful degradation)
TRACING_ENABLED=true
KAFKA_ENABLED=true

# Native Process Resource Limits (Safe for 16GB laptop)
GOMAXPROCS=2
GOMEMLIMIT=512MiB

EDGE_GATEWAY_GOMAXPROCS=2
EDGE_GATEWAY_GOMEMLIMIT=256MiB
CATALOG_GOMAXPROCS=2
CATALOG_GOMEMLIMIT=256MiB
SEARCH_GOMAXPROCS=1
SEARCH_GOMEMLIMIT=256MiB
CHECKOUT_GOMAXPROCS=2
CHECKOUT_GOMEMLIMIT=256MiB
INVENTORY_GOMAXPROCS=1
INVENTORY_GOMEMLIMIT=256MiB
PAYMENTS_GOMAXPROCS=1
PAYMENTS_GOMEMLIMIT=256MiB
CART_GOMAXPROCS=1
CART_GOMEMLIMIT=256MiB
NOTIFICATIONS_GOMAXPROCS=1
NOTIFICATIONS_GOMEMLIMIT=128MiB
EXTERNAL_BANK_MOCK_GOMAXPROCS=1
EXTERNAL_BANK_MOCK_GOMEMLIMIT=128MiB
REVIEWS_GOMAXPROCS=1
REVIEWS_GOMEMLIMIT=128MiB

# Replicas & Upstreams
CHECKOUT_UPSTREAMS=localhost:9003,localhost:9013
